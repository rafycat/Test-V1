# Copier ce fichier en .env et renseigner vos clés.
# Ne JAMAIS committer .env dans git (voir .gitignore).

# Découverte France : AUCUNE clé nécessaire. Le pipeline utilise l'API publique
# gratuite recherche-entreprises.api.gouv.fr (Sirene INSEE + RNE INPI, sans compte).

# Pappers — OPTIONNEL. N'ajoutez une clé que si vous voulez le signal
# "levée de fonds récente" (augmentation de capital publiée au greffe).
# Sans cette clé, le pipeline tourne quand même : CA et effectif viennent
# déjà de l'API gratuite ci-dessus. Clé batch dédiée, différente du
# connecteur MCP conversationnel déjà actif sur votre compte Claude.
PAPPERS_API_KEY=

# INPI — optionnel, uniquement pour le signal "dépôt de brevet/marque récent".
# Compte développeur gratuit sur data.inpi.fr.
INPI_API_KEY=

# Optionnel — uniquement si vous activez press.serpapi_enabled: true
# dans config/sources.yaml pour un mode 100% batch sans agent interactif.
SERPAPI_API_KEY=
