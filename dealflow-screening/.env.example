# Copiez ce fichier vers .env et renseignez les clés dont vous disposez.
# TOUTES sont optionnelles — le pipeline fonctionne avec uniquement
# fetch_entreprises_gouv.py (gratuit, sans clé) pour la découverte.

# Pappers — enrichissement (levées de fonds via augmentations de capital).
# Le connecteur MCP Pappers de votre compte Claude.ai est pour un usage
# conversationnel ponctuel, pas pour ce batch régulier -> clé API REST dédiée.
PAPPERS_API_KEY=

# INPI — enrichissement (brevets/marques + objet social + comptes annuels).
# Compte développeur GRATUIT sur data.inpi.fr (espace perso > "Mes accès API / SFTP").
INPI_USERNAME=
INPI_PASSWORD=

# INSEE Sirene V3 — historique effectif. Compte GRATUIT sur portail-api.insee.fr,
# abonnement à l'API "Sirene - V3", auth OAuth2 client_credentials.
INSEE_CLIENT_ID=
INSEE_CLIENT_SECRET=

# SerpAPI — optionnel, uniquement si vous voulez un mode 100% batch sans
# agent Claude Code pour la veille presse (search_press.py::fetch_via_serpapi).
SERPAPI_API_KEY=
